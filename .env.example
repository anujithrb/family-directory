# ============================================================
# Family Directory - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Node Environment: development | production | test
NODE_ENV=development

# PostgreSQL Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me
POSTGRES_DB=family_directory
POSTGRES_PORT=5432

# Self-hosted PostgreSQL (default — used by docker-compose.yml / docker-compose.prod.yml)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
# DIRECT_URL must match DATABASE_URL for self-hosted setups.
# For Supabase, set this to the direct (non-pooled) connection string instead.
DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Supabase free-tier database ──────────────────────────────────────────────
# Uncomment and fill in the two lines below when using Supabase as the database
# (used by docker-compose.supabase.yml). Leave the self-hosted lines above
# commented out in that case.
#
# Transaction-mode pooler URL  (used by the running app — supports high concurrency)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# Direct connection URL  (used by Prisma CLI for migrations only)
# DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# ─────────────────────────────────────────────────────────────────────────────

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redis_password_change_in_prod
REDIS_PORT=6379

# JWT Secrets - MUST be at least 32 characters and random
JWT_SECRET=change-this-to-a-random-32-char-minimum-secret
JWT_REFRESH_SECRET=change-this-to-another-random-32-char-minimum-secret

# CORS - Frontend origin
CORS_ORIGIN=http://localhost:4200

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Rate Limiting (auth routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Ports
BACKEND_PORT=3000
FRONTEND_PORT=4200

# Production only
# CORS_ORIGIN=https://yourdomain.com
