# ============================================================
# Family Directory - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Node Environment: development | production | test
NODE_ENV=development

# PostgreSQL Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me
POSTGRES_DB=family_directory
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redis_password_change_in_prod
REDIS_PORT=6379

# JWT Secrets - MUST be at least 32 characters and random
JWT_SECRET=change-this-to-a-random-32-char-minimum-secret
JWT_REFRESH_SECRET=change-this-to-another-random-32-char-minimum-secret

# CORS - Frontend origin
CORS_ORIGIN=http://localhost:4200

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Rate Limiting (auth routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Ports
BACKEND_PORT=3000
FRONTEND_PORT=4200

# Production only
# CORS_ORIGIN=https://yourdomain.com
